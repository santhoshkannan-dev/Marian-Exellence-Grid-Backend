# ==============================================================================
# Marian Best Class Evaluation Backend - Production Environment Template
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env' on your production host (never commit .env)
#   2. Fill in the real domain, secret key, database credentials, and admin emails.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False

# Generate a strong key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY="REPLACE_WITH_A_NEW_CRYPTOGRAPHICALLY_SECURE_SECRET_KEY"

# Comma-separated domains allowed to connect
DJANGO_ALLOWED_HOSTS="excellencegrid.mariancollege.org,api.mariancollege.org"

# ------------------------------------------------------------------------------
# 2. CORS & CSRF Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="https://excellencegrid.mariancollege.org"
CSRF_TRUSTED_ORIGINS="https://excellencegrid.mariancollege.org,https://api.mariancollege.org"

# ------------------------------------------------------------------------------
# 3. Google OAuth2
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="844955988511-9f9oh4sjrp3eqoimenpkdg0ho3ljr1bo.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=marian_best_class
DATABASE_USER=marian_prod_user
DATABASE_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_DATABASE_PASSWORD"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=300

# ------------------------------------------------------------------------------
# 5. Security & Observability
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=WARNING
SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 6. Admin Authentication Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of institutional emails granted system admin rights
ADMIN_EMAILS="prijil.mathew@mariancollege.org,juby.george@mariancollege.org"
