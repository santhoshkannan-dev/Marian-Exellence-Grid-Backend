# Marian Best Class Evaluation Backend Environment Configuration Template
# Duplicate this file to .env and provide your local/production credentials.
# NEVER commit or distribute .env with real secrets.

# Core Django Security
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
ENABLE_DEV_BYPASS=False
DJANGO_ALLOWED_HOSTS=marian.edu.in,api.marian.edu.in,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://marian.edu.in,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://marian.edu.in,https://api.marian.edu.in

# Google OAuth
GOOGLE_CLIENT_ID=

# Database Settings (Production must use PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=300

# Production Security Flags (Defaults to True/Strict when DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Observability & Monitoring (Optional)
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO

