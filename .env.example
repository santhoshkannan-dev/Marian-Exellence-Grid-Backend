# Marian Best Class Evaluation Backend Environment Configuration Template
# Duplicate this file to .env and provide your local credentials.
# NEVER commit or distribute .env with real secrets.

# Core Django Security
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
ENABLE_DEV_BYPASS=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=

# Database Settings
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Production Security Flags (Optional overrides in production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
