# ==============================================================================
# MARIAN COLLEGE ACTIVITY EVALUATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env'  →  cp .env.example .env
#   2. Fill in your local or production values below.
#   3. NEVER commit '.env' to version control — it is strictly git-ignored.
#   4. Keep this file (.env.example) committed: it uses only safe placeholder values.
# ==============================================================================


# --- SERVER & DJANGO CORE ---
# Run with DEBUG=False in staging and production environments.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
DJANGO_ALLOWED_HOSTS="marian.edu.in,api.marian.edu.in,localhost,127.0.0.1"

# Developer bypass login (ONLY effective when DJANGO_DEBUG=True — strictly disabled in production)
ENABLE_DEV_BYPASS=False


# --- SECURITY & AUTHENTICATION ---
# Cross-Origin Resource Sharing — list every frontend origin that may call the API.
CORS_ALLOWED_ORIGINS="https://marian.edu.in,http://localhost:3000"

# CSRF trusted origins — must include every origin that submits forms or uses the admin.
CSRF_TRUSTED_ORIGINS="https://marian.edu.in,https://api.marian.edu.in"


# --- ADMINISTRATIVE ACCESS CONTROL ---
# Comma-separated list of institutional email addresses granted system admin / superuser access.
# These accounts receive the 'admin' role on Google SSO login and are seeded as Django superusers.
# SECURITY: Never commit real email addresses here — add them only in your local .env file.
# Example: ADMIN_EMAILS="admin@yourinstitution.org,principal@yourinstitution.org"
ADMIN_EMAILS=""


# --- GOOGLE SSO AUTHENTICATION ---
# Obtain from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Only @mariancollege.org accounts are permitted to authenticate (enforced in auth_views.py).
# ALLOWED_EMAIL_DOMAIN is for documentation purposes; enforcement is hardcoded in the backend.
ALLOWED_EMAIL_DOMAIN="mariancollege.org"


# --- DATABASE CONFIGURATION ---
# Production MUST use PostgreSQL. SQLite is strictly rejected when DJANGO_DEBUG=False.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME="marian_eval_db"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_local_db_password"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
# Maximum seconds a database connection is kept alive (set to 0 to disable persistent connections).
DATABASE_CONN_MAX_AGE=300


# --- PRODUCTION SECURITY FLAGS ---
# These defaults are fail-safe: they are enforced as True/Strict when DJANGO_DEBUG=False.
# Set to False only if you are terminating TLS at a load balancer or reverse proxy.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000


# --- OBSERVABILITY & MONITORING ---
# Sentry DSN for error tracking (optional — leave blank to disable).
SENTRY_DSN=""
DJANGO_LOG_LEVEL=INFO
